aion_SetPromotionCooltimeForAC=====BODY=====CREATE procedure [dbo].[aion_SetPromotionCooltimeForAC]
	@nCharId							int,
	@nPromotionId 				smallint,
	@nLastPromotionTime 	int,
	@nReceivedItemCount		int,
	@nCycleReceivedItemCount	int,
	@nCycleNextResetTime		int
as
set nocount on
if EXISTS (SELECT promotion_id FROM user_promotion_cooltime(UPDLOCK) WHERE account_id=@nCharId and promotion_id=@nPromotionId) 
begin
	UPDATE user_promotion_cooltime
	SET last_promotion_time = @nLastPromotionTime, received_item_count = @nReceivedItemCount, cycle_received_item_count = @nCycleReceivedItemCount, cycle_next_reset_time = @nCycleNextResetTime	
	WHERE account_id=@nCharId and promotion_id=@nPromotionId
end
else
begin
	INSERT user_promotion_cooltime(account_id, promotion_id, last_promotion_time, received_item_count, cycle_received_item_count, cycle_next_reset_time) 
	VALUES (@nCharId, @nPromotionId, @nLastPromotionTime, @nReceivedItemCount, @nCycleReceivedItemCount, @nCycleNextResetTime)	
end
set nocount off

aion_SetTrialAccountData=====BODY=====-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- =============================================
CREATE PROCEDURE [dbo].[aion_SetTrialAccountData]
	@accountId int,
	@updateTime int,
	@resetTime int,
	@sellGold bigint,
	@tradeGold bigint,
	@decomposeSum int,
	@gatherSum int,
	@extractGatherSum int	
	
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

	if EXISTS (SELECT account_id FROM trial_account_data(UPDLOCK) WHERE account_id=@accountId) 
	begin
		UPDATE trial_account_data
		SET update_time=@updateTime, reset_time=@resetTime, sell_gold_sum=@sellGold,
			trade_gold_sum=@tradeGold, decompose_sum=@decomposeSum, gather_sum=@gatherSum, extract_gather_sum=@extractGatherSum	
		WHERE account_id=@accountId AND @updateTime > update_time 
	end
	else
	begin
		INSERT trial_account_data(account_id, update_time, reset_time, sell_gold_sum, trade_gold_sum, decompose_sum, gather_sum, extract_gather_sum) 
		VALUES (@accountId, @updateTime, @resetTime, @sellGold, @tradeGold, @decomposeSum, @gatherSum, @extractGatherSum)	
	end
	
	SET NOCOUNT OFF;
END

aion_SetUserInfo_20120703=====BODY=====-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- =============================================
CREATE PROCEDURE [dbo].[aion_SetUserInfo_20120703]
	@char_id int,
	@account_id int,
	@server_id int,
	@cur_server_id int,
	@char_lev int,
	@create_date datetime,
	@login_time datetime,
	@logout_time datetime,
	--@create_date int,
	--@login_time int,
	--@logout_time int,
	@delete_date int,
	@delete_complete_date int
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;
	
    DECLARE @utc_adjust BIGINT
    SET @utc_adjust = dbo.GetUtcAdjustSecWithUTC_Local(GetUTCDate(), GetDate())

    -- Insert statements for procedure here
    if EXISTS (select char_id from global_user_data with(UPDLOCK) where char_id = @char_id and server_id = @server_id)
    begin
		UPDATE global_user_data
		SET create_date = @create_date, last_login_time = @login_time, last_logout_time = @logout_time, delete_date = @delete_date, delete_completed_date = @delete_complete_date, user_level = @char_lev, cur_server_id = @cur_server_id
		WHERE char_id = @char_id and server_id = @server_id
    end
    else begin
		INSERT global_user_data(char_id, account_id, create_date, last_login_time, last_logout_time, delete_date, delete_completed_date, server_id, cur_server_id, user_level)
		VALUES (@char_id, @account_id
				, @create_date
				, @login_time
				, @logout_time
				--, dateadd(ss,@create_date+@utc_adjust,'1970-01-01')
				--, dateadd(ss,@login_time+@utc_adjust,'1970-01-01')  /* last_login_time */
				--, dateadd(ss,@logout_time+@utc_adjust,'1970-01-01')  /* @logout_time */
				, @delete_date  /* @delete_date */
				, @delete_complete_date /* @delete_complete_date */
				, @server_id, @cur_server_id, @char_lev)
	end
			    
    RETURN @@rowcount			
END

