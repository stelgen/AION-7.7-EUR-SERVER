aion_MonsterCoreAddCount=====BODY=====CREATE PROC [dbo].[aion_MonsterCoreAddCount]
	@accountId	int,
	@coreId		int,
	@addCount	int
AS
BEGIN
	SET NOCOUNT ON

	UPDATE	user_monster_core
	SET		core_count += @addCount,
			total_added += @addCount
	WHERE	account_id = @accountId AND core_id = @coreId
	
	IF (@@ROWCOUNT = 0)
	BEGIN
		INSERT	user_monster_core (account_id, core_id, core_grade, core_count, total_added, total_used)
		VALUES (@accountId, @coreId, 0, @addCount, @addCount, 0)
	END

END

aion_MonsterCoreUpdate=====BODY=====CREATE PROC [dbo].[aion_MonsterCoreUpdate]
	@accountId	int,
	@coreId		int,
	@coreGrade	int,
	@coreCount	int
AS
BEGIN
	SET NOCOUNT ON

	UPDATE	user_monster_core
	SET		core_count = @coreCount,
			core_grade = @coreGrade
	WHERE	account_id = @accountId AND core_id = @coreId
	
	IF (@@ROWCOUNT = 0)
	BEGIN
		INSERT	user_monster_core (account_id, core_id, core_grade, core_count, total_added, total_used)
		VALUES (@accountId, @coreId, @coreGrade, @coreCount, @coreCount, 0)
	END
	
END

aion_MonsterCoreUpgradeAndDecreaseCount=====BODY=====CREATE PROC [dbo].[aion_MonsterCoreUpgradeAndDecreaseCount]
	@accountId	int,
	@coreId		int,
	@countForUpgrade	int
AS
BEGIN
	SET NOCOUNT ON
	
	UPDATE	user_monster_core
	SET		core_grade += 1,
			core_count -= @countForUpgrade,
			total_used += @countForUpgrade
	WHERE	account_id = @accountId AND core_id = @coreId
	
END

