	@feat_leg_length 	tinyint,
	@feat_shoulder_width 	tinyint,
	@feat_head_figure	tinyint -- ????
AS
BEGIN
set nocount on
INSERT cosmetic_data (account_id, server_id, char_id, race, gender, 
	feat_version,
	
	head_face_color, head_hair_color, head_eye_color, head_lip_color, head_face_type, head_hair_type, 
	height_scale, head_voice_type, 
	head_feat_type1, head_feat_type2, head_bump_type, head_expression_type,	
	
	feat_face_shape,
	feat_forehead_shape,
	feat_eye_position,
	feat_eye_glabella,
	feat_eye_length,
	feat_eye_height,
	feat_eye_shape,
	feat_eye_tail,
	feat_eyeblow_pos,
	feat_eyeblow_angle,
	feat_eyeblow_shape,
	feat_nose_pos,
	feat_nose_bridge,
	feat_nose_side,
	feat_nose_tip,
	feat_cheek_shape,
	feat_mouth_pos,
	feat_mouth_size,
	feat_lip_thickness,
	feat_lip_tail,
	feat_lip_shape,
	feat_jaw_pos,
	feat_jaw_shape,
	feat_ear_shape,
	feat_head_size,
	feat_neck_thickness,
	feat_neck_length,
	feat_shoulder_size,
	feat_upper_size,
	feat_bust_size,
	feat_waist_size,
	feat_hip_size,
	feat_arm_thickness,
	feat_hand_size,
	feat_leg_thickness,
	feat_foot_size,
	feat_face_ratio,
	feat_wing_size,
	feat_arm_length,
	feat_leg_length,
	feat_shoulder_width,
	feat_head_figure,
	create_date
)
 VALUES ( @nAccountId, @nServerId, @nCharId, @nRace, @nGender, 
 
 	@feat_version,
 
	@nHeadFaceColor, @nHeadHairColor, @nEyeColor, @nLipColor, @nHeadFaceType, @nHeadHairType, 
	@fScale, @nVoiceType, 
	@nFeatType1, @nFeatType2, @nHeadBumpType, @nHeadExpressionType,	
	
	@feat_face_shape,
	@feat_forehead_shape,
	@feat_eye_position,
	@feat_eye_glabella,
	@feat_eye_length,
	@feat_eye_height,
	@feat_eye_shape,
	@feat_eye_tail,
	@feat_eyeblow_pos,
	@feat_eyeblow_angle,
	@feat_eyeblow_shape,
	@feat_nose_pos,
	@feat_nose_bridge,
	@feat_nose_side,
	@feat_nose_tip,
	@feat_cheek_shape,
	@feat_mouth_pos,
	@feat_mouth_size,
	@feat_lip_thickness,
	@feat_lip_tail,
	@feat_lip_shape,
	@feat_jaw_pos,
	@feat_jaw_shape,
	@feat_ear_shape,
	@feat_head_size,
	@feat_neck_thickness,
	@feat_neck_length,
	@feat_shoulder_size,
	@feat_upper_size,
	@feat_bust_size,
	@feat_waist_size,
	@feat_hip_size,
	@feat_arm_thickness,
	@feat_hand_size,
	@feat_leg_thickness,
	@feat_foot_size,
	@feat_face_ratio,
	@feat_wing_size,
	@feat_arm_length,
	@feat_leg_length,
	@feat_shoulder_width,
	@feat_head_figure,
	GetDate()	
)
set nocount off

 IF @@ERROR <> 0
	return 0

return @@IDENTITY
END

aion_PutTransform=====BODY=====CREATE PROCEDURE [dbo].[aion_PutTransform]
	@account_id		int,
	@name_id		int,
	@count			int,
	@server_id		int
AS
BEGIN
	SET NOCOUNT ON

	IF EXISTS (SELECT account_id FROM user_transform (UPDLOCK) WHERE account_id = @account_id AND name_id = @name_id and server_id = @server_id)
		BEGIN
			UPDATE user_transform 
			SET count = @count, update_time = GETDATE() 
			WHERE account_id = @account_id AND name_id = @name_id and server_id = @server_id
		END
	ELSE 
		BEGIN
			INSERT user_transform(account_id, name_id, count,server_id) VALUES (@account_id, @name_id, @count,@server_id)
		END

	SET NOCOUNT OFF
END

aion_PutUserDataFromAllServer=====BODY=====CREATE PROCEDURE [dbo].[aion_PutUserDataFromAllServer] 
	@db_userId	nvarchar(64),
	@db_passwd	nvarchar(64)
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;


	declare @server_id int 
	declare @sync_server_id int
	declare @ret int

	declare syncChar_cursor cursor for select server_id from aion_serverlist
	open syncChar_cursor
	fetch next from syncChar_cursor into @sync_server_id

	while @@fetch_status = 0
	begin
		SET @ret = -10000
		exec aion_PutUserDataFromServer @db_userId, @db_passwd, @sync_server_id, @ret output

		update aion_serverlist set update_result = @ret where server_id = @sync_server_id


		fetch next from syncChar_cursor into @sync_server_id
	end

	close syncChar_cursor
	deallocate syncChar_cursor

END

aion_PutUserDataFromServer=====BODY=====/*
Return ??
	:

*/

-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- =============================================
CREATE PROCEDURE [dbo].[aion_PutUserDataFromServer] 
	@db_userId	nvarchar(64),
	@db_passwd	nvarchar(64),
	@serverId int,
	@ret	int	output
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

	declare @serverName  nvarchar(128)
	set @serverName = ''
	declare @databaseName  nvarchar(64)
	set @databaseName = ''
	select @serverName = datasource, @databaseName = database_name from aion_serverlist where server_id = @serverId
	if @@rowcount = 0
	begin
		set @ret = -1	-- DB? ?? ??? ??
		return
	end

	declare @db_info nvarchar(256)
	set @db_info = '''' + @serverName + ''';''' + @db_userId + ''';''' + @db_passwd + ''''


	declare @sql	nvarchar(4000)


	-- ?? ?? ?? acc db? ??
	set @sql = 'insert into global_user_data('
				+ ' char_id, account_id, create_date, last_login_time, last_logout_time, delete_date, delete_completed_date, user_level, server_id'
				+ ') '
				+ ' select '
				+ ' o.char_id, o.account_id, o.create_date, o.last_login_time, o.last_logout_time, o.delete_date, o.delete_complete_date, o.lev, '
				+ ' ' + cast(@serverId as nvarchar) 
				+ ' from openrowset (''SQLOLEDB'', ' + @db_info + ','
				+ ' ''select char_id, account_id, lev, create_date, last_login_time, last_logout_time, delete_date, delete_complete_date from ' + @databaseName + '.dbo.user_data '' ) as o'
				+ ' left join global_user_data on global_user_data.char_id = o.char_id and global_user_data.server_id = ' + cast(@serverId as nvarchar) 
				+ ' where global_user_data.char_id is null'

	--print @sql
	exec (@sql)
	set @ret = @@ROWCOUNT
	
	if @@error <> 0	
	begin 
		set @ret = -2	-- ?? ??!!!
	end
	
	
/*

insert global_user_data(char_id, account_id, create_date, last_login_time, last_logout_time, delete_date, delete_completed_date, user_level, server_id)
select char_id, account_data, create_date, last_login_time, last_logout_time, delete_date, delete_completed_date, lev, @serverId
from openrowset('SQLOLEDB', 'jungsuk-pc-i7';'sa';'dkdldhs2005!', 'select char_id, account_id, lev, create_date, last_login_time, last_logout_time, delete_date, delete_complete_date from aionworldjung.dbo.user_data' ) as o 
		left join global_user_data on global_user_data.char_id = o.char_id and global_user_data.server_id = @serverId
where global_user_data.char_id is null

*/
	
END

aion_QueryCanCreateJumpingCharacter=====BODY=====CREATE PROCEDURE [dbo].[aion_QueryCanCreateJumpingCharacter]
	@account_id int,
	@server_id int,					-- ?????? ?? ????
	@from_special tinyint,			-- ?????/?????? ?? ????? ???
	
	@can_create_num int output,		-- ?? ? ?? ?? ??? ?
	@satisfy_date tinyint output,
	@satisfy_char_lev tinyint output
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;
    -- Insert statements for procedure here
    declare @cur_date datetime
    set @cur_date = getdate()
    
    declare @max_creation_count int
    declare @required_char_level int
    declare @start_date datetime
    declare @end_date datetime
    SELECT @max_creation_count = max_creation_count, @required_char_level = required_char_level, @start_date = start_date, @end_date = end_date
    FROM jumping_character_config(nolock) WHERE server_id = @server_id and start_date < @cur_date and @cur_date < end_date and is_deleted = 0
    
    IF (ISNULL(@max_creation_count, 0) > 0)
	begin
		set @satisfy_date = 1;
		-- ???? ??? ???? ??? ??		
		IF (EXISTS(SELECT char_id FROM global_user_data(nolock) WHERE account_id = @account_id and is_special_server = @from_special and user_level >= @required_char_level and delete_completed_date = 0)
			OR @required_char_level = 0) -- 0??? ??? ?? ??? ???? ??
		begin
			set @satisfy_char_lev = 1;
			-- ?? ??? ?? ?? ???? ?? ?????? ???
			declare @cur_creation_num int
			SELECT @cur_creation_num = COUNT(*)
			FROM global_user_data(nolock)
			WHERE account_id = @account_id and is_special_server = @from_special and create_date > @start_date and create_date < @end_date and is_jumping_character != 0
			
			set @cur_creation_num = ISNULL(@cur_creation_num, 0)
			set @can_create_num = @max_creation_count - @cur_creation_num
		end
		ELSE
		begin
			set @satisfy_char_lev = 0
			set @can_create_num = 0
		end
	end
    ELSE
	begin
		set @satisfy_date = 0
		set @satisfy_char_lev = 0
		set @can_create_num = 0
    end
END

aion_QueryCanCreateJumpingCharacter_20170428=====BODY=====CREATE PROCEDURE [dbo].[aion_QueryCanCreateJumpingCharacter_20170428]
	@account_id int,
	@server_id int,					-- ?????? ?? ????
	@from_special tinyint,			-- ?????/?????? ?? ????? ???
	
	@can_create_num int output,		-- ?? ? ?? ?? ??? ?
	@satisfy_date tinyint output,
	@satisfy_char_lev tinyint output,

	@limit_reset_time int output,
	@limit_play_time int output
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;
    -- Insert statements for procedure here
    declare @cur_date datetime
    set @cur_date = getdate()
    
    declare @max_creation_count int
    declare @required_char_level int
    declare @start_date datetime
    declare @end_date datetime
    SELECT @max_creation_count = max_creation_count, @required_char_level = required_char_level, @start_date = start_date, @end_date = end_date
    FROM jumping_character_config(nolock) WHERE server_id = @server_id and start_date < @cur_date and @cur_date < end_date and is_deleted = 0
    
    IF (ISNULL(@max_creation_count, 0) > 0)
	begin
		set @satisfy_date = 1;
		-- ???? ??? ???? ??? ??		
		IF (EXISTS(SELECT char_id FROM global_user_data(nolock) WHERE account_id = @account_id and is_special_server = @from_special and user_level >= @required_char_level and delete_completed_date = 0)
			OR @required_char_level = 0) -- 0??? ??? ?? ??? ???? ??
		begin
			set @satisfy_char_lev = 1;
			-- ?? ??? ?? ?? ???? ?? ?????? ???
			declare @cur_creation_num int
			SELECT @cur_creation_num = COUNT(*)
			FROM global_user_data(nolock)
			WHERE account_id = @account_id and is_special_server = @from_special and create_date > @start_date and create_date < @end_date and is_jumping_character != 0
			
			set @cur_creation_num = ISNULL(@cur_creation_num, 0)
			set @can_create_num = @max_creation_count - @cur_creation_num

			-- ????
			SELECT @limit_reset_time = limit_play_reset_time, @limit_play_time = limit_play_accum_time FROM account_data WHERE account_id = @account_id

			set @limit_reset_time = ISNULL(@limit_reset_time, 0)
			set @limit_play_time = ISNULL(@limit_play_time, 0)
		end
		ELSE
		begin
			set @satisfy_char_lev = 0
			set @can_create_num = 0
			set @limit_reset_time = 0
			set @limit_play_time = 0
		end
	end
    ELSE
	begin
		set @satisfy_date = 0
		set @satisfy_char_lev = 0
		set @can_create_num = 0
		set @limit_reset_time = 0
		set @limit_play_time = 0
    end
END

aion_ResetLunaReward=====BODY=====create procedure [dbo].[aion_ResetLunaReward] 
	@accountId int	
as 
begin
	declare @currentReward int, @remainReward int
	declare @updateTime datetime
	set @currentReward = 0
	set @remainReward = 0
	
	declare @curdate datetime
	set @curdate = dateadd(hour, 9, convert(datetime, convert(date, GETDATE())))
		
	begin tran	
			
	select @currentReward = today_reward, @remainReward = remain_reward, @updateTime = updatedate from account_luna_reward where accountId = @accountId
			
	if @@ROWCOUNT <> 0 			
		begin
			if getdate() > @curdate and  @updateTime <= @curdate	--?? ???? ??? ?? ???? ???. ??? ??? ?? ??? ????.
			begin 
				set @currentReward = 0
				set @remainReward = 0
				update account_luna_reward set today_reward = @currentReward, remain_reward = @remainReward, updatedate = GETDATE() where accountId = @accountId 
			end					
		end		
	commit tran	
	return 0
end

