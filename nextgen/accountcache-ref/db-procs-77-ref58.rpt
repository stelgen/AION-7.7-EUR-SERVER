GM_LunaInfoListDA_DecreaseLunaAmount=====BODY=====CREATE PROC [dbo].[GM_LunaInfoListDA_DecreaseLunaAmount] 
	@accountId int,
	@decreaseLunaAmount bigint
AS

BEGIN
	IF @decreaseLunaAmount > 0
		BEGIN
			UPDATE account_luna 
			SET luna = luna - @decreaseLunaAmount, updatedate = GETDATE() 
			WHERE accountId = @accountId AND luna >= @decreaseLunaAmount
		END
END

GM_LunaInfoListDA_SrchLunaAmount=====BODY=====CREATE PROC [dbo].[GM_LunaInfoListDA_SrchLunaAmount]
	@accountId	int
AS
BEGIN
	set nocount on
	set transaction isolation level read uncommitted

	SELECT	luna, createdate, updatedate
	FROM	account_luna (nolock)
	WHERE	accountId = @accountId
END

GM_LunaInfoListDA_SrchLunaReward=====BODY=====CREATE PROC [dbo].[GM_LunaInfoListDA_SrchLunaReward]
	@accountId	int
AS
BEGIN
	set nocount on
	set transaction isolation level read uncommitted

	SELECT	today_reward, remain_reward, key_count, createdate, updatedate
	FROM	account_luna_reward (nolock)
	WHERE	accountId = @accountId
END

GM_MonsterCoreDA_DeleteMonsterCoreByAccountId=====BODY=====CREATE PROCEDURE [dbo].[GM_MonsterCoreDA_DeleteMonsterCoreByAccountId]
	@account_id int,
	@monster_core_id int
AS
BEGIN
	SET NOCOUNT ON;
	DELETE FROM [user_monster_core]
      WHERE account_id = @account_id and core_id = @monster_core_id
END

GM_MonsterCoreDA_InsertMonsterCoreByAccountId=====BODY=====--6.2 ??? ??
CREATE PROCEDURE [dbo].[GM_MonsterCoreDA_InsertMonsterCoreByAccountId]
	@account_id int,
	@monster_core_id int,
	@grade int,
	@count int,
	@total_added int,
	@total_used int
AS
BEGIN
	INSERT INTO [dbo].[user_monster_core]
           ([account_id],[core_id],[core_grade],[core_count],[total_added],[total_used])
	VALUES (@account_id,@monster_core_id,@grade, @count, @total_added, @total_used)
END

GM_MonsterCoreDA_SrchMonsterCoreByAccountId=====BODY=====CREATE PROCEDURE [dbo].[GM_MonsterCoreDA_SrchMonsterCoreByAccountId]
	@account_id int
AS
BEGIN
	SET NOCOUNT ON;
	SELECT id, account_id, core_id, core_grade, core_count 
	FROM [user_monster_core] (nolock) where account_id = @account_id
END

GM_MonsterCoreDA_UpdateMonsterCoreByAccountId=====BODY=====--6.2 ??? ??
CREATE PROCEDURE [dbo].[GM_MonsterCoreDA_UpdateMonsterCoreByAccountId]
	@account_id int,
	@monster_core_id int,
	@grade int,
	@count int
AS
BEGIN
	update user_monster_core
	set core_grade = @grade , core_count = @count
	where account_id = @account_id and core_id = @monster_core_id
END

GM_TransformDA_DeleteTransformByAccountId=====BODY=====CREATE PROCEDURE [dbo].[GM_TransformDA_DeleteTransformByAccountId]
	@account_id int,
	@transform_id int
AS
BEGIN
	delete from user_transform where account_id = @account_id and name_id = @transform_id
END

GM_TransformDA_InsertTransformByAccountId=====BODY=====CREATE PROCEDURE [dbo].[GM_TransformDA_InsertTransformByAccountId]
	@account_id int,
	@transform_id int,
	@count int
AS
BEGIN
	INSERT INTO [dbo].[user_transform]
			([account_id],[name_id],[count],[update_time])
	VALUES (@account_id,@transform_id,@count,GetDate())
END

GM_TransformDA_SrchTransformByAccountId=====BODY=====CREATE PROCEDURE [dbo].[GM_TransformDA_SrchTransformByAccountId]
	@account_id int
AS
BEGIN
	SET NOCOUNT ON;
	SELECT name_id, count, update_time 
	FROM [user_transform] (nolock) where account_id = @account_id
END

GM_TransformDA_UpdateTransformByAccountId=====BODY=====CREATE PROCEDURE [dbo].[GM_TransformDA_UpdateTransformByAccountId]
	@account_id int,
	@transform_id int,
	@count int
AS
BEGIN
	UPDATE [dbo].[user_transform]
	SET [count] = @count, [update_time] = GetDate()
	WHERE account_id=@account_id and name_id = @transform_id
END

GM_UserRankingDA_SrchUserListByRankId=====BODY=====CREATE PROC [dbo].[GM_UserRankingDA_SrchUserListByRankId]
	@rank_id int, 
	@is_special_server int
AS
BEGIN
	SET NOCOUNT ON;

	SELECT	TOP 1 SpecialServerType, RankId, SeasonNumber, convert(nvarchar,LastUpdateTime,20) LastUpdateTime, SeasonStatus,TableDump, TableVersion
	FROM	aion_ranking_info (nolock) where RankId = @rank_id and SpecialServerType = @is_special_server order by Id Desc 
END

