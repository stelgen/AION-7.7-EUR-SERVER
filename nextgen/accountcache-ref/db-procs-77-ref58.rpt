aion_SyncUserDataFromServer=====BODY=====/*
Return ??
	:

*/

-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- =============================================
CREATE PROCEDURE [dbo].[aion_SyncUserDataFromServer] 
	@db_userId	nvarchar(64),
	@db_passwd	nvarchar(64),
	@serverId int,
	@ret	int	output
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

	declare @serverName  nvarchar(128)
	set @serverName = ''
	declare @databaseName  nvarchar(64)
	set @databaseName = ''
	select @serverName = datasource, @databaseName = database_name from aion_serverlist where server_id = @serverId
	if @@rowcount = 0
	begin
		set @ret = -1	-- DB? ?? ??? ??
		return
	end

	declare @db_info nvarchar(256)
	set @db_info = '''' + @serverName + ''';''' + @db_userId + ''';''' + @db_passwd + ''''


	declare @sql	nvarchar(4000)


	-- ?? ?? ?? acc db? ??
	set @sql = 'update global_user_data'
				+ ' set create_date = o.create_date, last_login_time = o.last_login_time, last_logout_time = o.last_logout_time, delete_date = o.delete_date, delete_completed_date = o.delete_complete_date, user_level = o.lev'
				+ ' from global_user_data'
				+ ' join openrowset (''SQLOLEDB'', ' + @db_info + ','
				+ ' ''select char_id, account_id, lev, create_date, last_login_time, last_logout_time, delete_date, delete_complete_date from ' + @databaseName + '.dbo.user_data '' ) as o'
				+ '   on global_user_data.char_id = o.char_id '
				+ ' 	and ( global_user_data.create_date != o.create_date '
				+ ' 			or global_user_data.last_login_time != o.last_login_time '
				+ ' 			or global_user_data.last_logout_time != o.last_logout_time '
				+ ' 			or global_user_data.delete_date != o.delete_date '
				+ ' 			or global_user_data.delete_completed_date != o.delete_complete_date '
				+ ' 			or global_user_data.user_level != o.lev )	'
				+ '	where global_user_data.server_id = ' + cast(@serverId as nvarchar) 

	--print (@sql)
	exec (@sql)

	if @@error <> 0	
	begin 
		set @ret = -2	-- ?? ??!!!
	end
/*
update global_user_data
set create_date = o.create_date
	, last_login_time = o.last_login_time
	, last_logout_time = o.last_logout_time
	, delete_date = o.delete_date
	, delete_completed_date = o.delete_complete_date
	, user_level = o.lev
from global_user_data
	join openrowset('SQLOLEDB', 'jungsuk-pc-i7';'sa';'dkdldhs2005!', 'select char_id, account_id, lev, create_date, last_login_time, last_logout_time, delete_date, delete_complete_date from aionworldjung.dbo.user_data' ) as o 
		  on global_user_data.char_id = o.char_id 
			and ( global_user_data.create_date != o.create_date 
					or global_user_data.last_login_time != o.last_login_time
					or global_user_data.last_logout_time != o.last_logout_time
					or global_user_data.delete_date != o.delete_date 
					or global_user_data.delete_completed_date != o.delete_complete_date
					or global_user_data.user_level != o.lev )
where global_user_data.server_id = @serverId



insert global_user_data(char_id, account_id, create_date, last_login_time, last_logout_time, delete_date, delete_completed_date, user_level, server_id)
select char_id, account_data, create_date, last_login_time, last_logout_time, delete_date, delete_completed_date, lev, @serverId
from openrowset('SQLOLEDB', 'jungsuk-pc-i7';'sa';'dkdldhs2005!', 'select char_id, account_id, lev, create_date, last_login_time, last_logout_time, delete_date, delete_complete_date from aionworldjung.dbo.user_data' ) as o 
		left join global_user_data on global_user_data.char_id = o.char_id and global_user_data.server_id = @serverId
where global_user_data.char_id is null

*/
	
END

aion_UpdateBoardBMState=====BODY=====-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- =============================================
CREATE PROCEDURE [dbo].[aion_UpdateBoardBMState]
	@account_id int,
	@game_id int,
	@current_pos int,
	@visited_pos bigint,
	@last_freecharge_time bigint,
	@last_reset_teim bigint,
	@free_dice_remain int,
	@paid_dice_remain int,
	@paid_reset_remain int
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;
    -- Insert statements for procedure here
    IF EXISTS (SELECT account_id 
				FROM user_board_bm
				WHERE account_id=@account_id)
    begin
		UPDATE user_board_bm
		SET game_id = @game_id, 
			current_pos = @current_pos, 
			visited_pos = @visited_pos, 
			last_freecharge_time = @last_freecharge_time, 
			last_reset_time = @last_reset_teim, 
			free_dice_remain = @free_dice_remain, 
			paid_dice_remain = @paid_dice_remain,
			paid_reset_remain = @paid_reset_remain
		WHERE account_id = @account_id
	end
	ELSE
	begin
		INSERT user_board_bm(account_id, game_id, current_pos, visited_pos, last_freecharge_time, last_reset_time, free_dice_remain, paid_dice_remain, paid_reset_remain)
		VALUES (@account_id, @game_id, @current_pos, @visited_pos, @last_freecharge_time, @last_reset_teim, @free_dice_remain, @paid_dice_remain, @paid_reset_remain)
	end
	
    RETURN @@rowcount
END

aion_UpdateBoardBMState_2017=====BODY=====CREATE PROCEDURE [dbo].[aion_UpdateBoardBMState_2017]
	@account_id int,
	@isSpecial int,
	@game_id int,
	@current_pos int,
	@visited_pos bigint,
	@last_freecharge_time bigint,
	@last_reset_time bigint,
	@free_dice_remain int,
	@paid_dice_remain int,
	@paid_reset_remain int
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;
    -- Insert statements for procedure here
    IF EXISTS (SELECT account_id FROM user_board_bm_dice WHERE account_id=@account_id)
    begin
		UPDATE user_board_bm_dice
		SET 
			last_freecharge_time = @last_freecharge_time,
			free_dice_remain = @free_dice_remain, 
			paid_dice_remain = @paid_dice_remain,
			paid_reset_remain = @paid_reset_remain
		WHERE account_id = @account_id
	end
	ELSE
	begin
		INSERT user_board_bm_dice(account_id, last_freecharge_time, free_dice_remain, paid_dice_remain, paid_reset_remain)
		VALUES (@account_id, @last_freecharge_time, @free_dice_remain, @paid_dice_remain, @paid_reset_remain)
	end
	
	IF EXISTS (SELECT account_id FROM user_board_bm_game WHERE account_id=@account_id and is_special_server = @isSpecial)
    begin
		UPDATE user_board_bm_game
		SET 
			game_id = @game_id,
			current_pos = @current_pos, 
			visited_pos = @visited_pos,
			last_reset_time = @last_reset_time
		WHERE account_id = @account_id and is_special_server = @isSpecial
	end
	ELSE
	begin
		INSERT user_board_bm_game(account_id, is_special_server, game_id, current_pos, visited_pos, last_reset_time)
		VALUES (@account_id, @isSpecial, @game_id, @current_pos, @visited_pos, @last_reset_time)
	end
	
	
    RETURN @@rowcount
END

aion_UpdateHiddenFatigueInfo=====BODY=====-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- =============================================
CREATE PROCEDURE [dbo].[aion_UpdateHiddenFatigueInfo]
	@accountId int,
	@hidden_fatigue_point int,
	@hidden_fatigue_updatetime int
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

	if EXISTS (SELECT account_id FROM account_data(UPDLOCK) WHERE account_id=@accountId) 
	begin
		UPDATE account_data
		SET hidden_fatigue_point = @hidden_fatigue_point, hidden_fatigue_updatetime = @hidden_fatigue_updatetime
		where account_id = @accountId
	end
	else
	begin
