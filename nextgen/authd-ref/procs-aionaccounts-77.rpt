===== PROC ap_SetServerStatus ===== 
/**
*Creator        :   Jaewon Ryu
*SP Name        :   dbo.[ap_SetServerStatus]
*Purpose        :   Update the state of the server
*E-Mail         :   veni@ncsoft.net
*Date           :   09/19/2008
*Usage          :
*M.History      :      
*===============================================================================
*Input Parameter    :  
*       @gameServerNo
*               gameServerNo
*       @statusCode
*               the current state of the game server
*/
 
create  PROCEDURE [dbo].[ap_SetServerStatus]
        @gameServerNo   TINYINT,
        @statusCode             TINYINT                
AS
 
IF @gameServerNo = 0
BEGIN
        UPDATE  worldStatus
        SET             status = @statusCode
END
ELSE
BEGIN
        UPDATE  worldStatus
        SET             status = @statusCode
        WHERE   idx = @gameServerNo
END
 
RETURN
 
 
SET QUOTED_IDENTIFIER ON

