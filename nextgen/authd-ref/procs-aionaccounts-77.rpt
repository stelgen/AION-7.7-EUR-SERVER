===== PROC agent_CreateAccount ===== 



CREATE PROCEDURE [dbo].[agent_CreateAccount]

	@ggid uniqueidentifier,
	@account varchar(14),
	@password binary(16),
	@email varchar(50),
	@mobile varchar(20),
	@question1 varchar(255),
	@question2 varchar(255),
	@answer1 binary(32),
	@answer2 binary(32)

AS
DECLARE @account_num int

SELECT account FROM user_info WHERE account = @account
IF @@ROWCOUNT <> 0
BEGIN
        RETURN 0;
END

SELECT ssn FROM ssn WHERE email = @email
IF @@ROWCOUNT <> 0
BEGIN
        RETURN 0;
END

set @account_num = 1

DECLARE @ssn varchar (13)
set @ssn = SUBSTRING ( @account ,0 , 9 )  + '-ssn'
 
BEGIN TRAN 
    
        INSERT ssn ( ssn, name, email, newsletter, job, phone, mobile, reg_date, zip, addr_main, addr_etc, account_num, status_flag)
        VALUES (@ssn, @account, @email,0,0,@mobile,@mobile,getdate(),'','','',@account_num,0)
        IF @@ERROR <> 0 GOTO DO_ROLLBACK

        INSERT user_account (account, pay_stat) 
		VALUES (@account, 1)
        IF @@ERROR <> 0 GOTO DO_ROLLBACK

        INSERT user_auth ( account, password, quiz1, quiz2, answer1, answer2, new_pwd_flag)
        VALUES ( @account, @password, @question1, @question2, @answer1, @answer2, 0)
        IF @@ERROR <> 0 GOTO DO_ROLLBACK

        INSERT user_info ( account, create_date, ssn, status_flag, kind )
        VALUES ( @account, getdate(),@ssn, 0, 99  )
        IF @@ERROR <> 0 GOTO DO_ROLLBACK       
       
       
COMMIT TRAN

set @account_num = 0;
SELECT @account_num = uid FROM user_account WHERE account=@account
IF @@ERROR <> 0 GOTO DO_ROLLBACK  

RETURN @account_num
 

DO_ROLLBACK:
ROLLBACK TRAN
RETURN 0

===== PROC ap_AutoReg ===== 
CREATE PROCEDURE [dbo].[ap_AutoReg]
@account varchar(14)
AS
BEGIN
set nocount on
declare @ssn char(13)
set @ssn=substring(STR(FLOOR(RAND()*8999999+1000000)),4,7)+substring(STR(FLOOR(RAND()*899999+100000)),5,6)
INSERT INTO user_account (account,pay_stat) VALUES (@account, 1)
INSERT INTO [ssn](ssn,name,email,job,phone,zip,addr_main,addr_etc,account_num) VALUES (@ssn,@account,'tmp@kamael.ru','0','telphone','123456','','',1)
INSERT INTO user_auth (account,password,quiz1,quiz2,answer1,answer2,new_pwd_flag) VALUES (@account,0x00000000000000000000000000000000,'1','2',0x0,0x0,3)
INSERT INTO user_info (account,ssn,kind,code) VALUES (@account,@ssn, 99, '123')
set nocount off
END
 

